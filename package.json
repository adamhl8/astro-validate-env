{
  "name": "astro-validate-env",
  "version": "0.3.1",
  "type": "module",
  "description": "A environment variable validation integration for Astro",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adamhl8/astro-validate-env.git"
  },
  "homepage": "https://github.com/adamhl8/astro-validate-env",
  "bugs": {
    "url": "https://github.com/adamhl8/astro-validate-env/issues"
  },
  "author": {
    "email": "adamhl@pm.me",
    "name": "Adam Langbert",
    "url": "https://github.com/adamhl8"
  },
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist/"],
  "keywords": ["astro", "astro-integration", "astro-component", "withastro", "utility", "environment variables", "env"],
  "scripts": {
    "bundle": "bun lint && tsdown",
    "lint": "markdown-toc -i --bullets '-' --maxdepth 3 ./README.md && ts-import-fix -w && tsc --noEmit && biome check --write && adamhl8-knip",
    "prepare": "find .githooks -type f -exec ln -srf {} .git/hooks/ \\; || true",
    "prepublishOnly": "bun bundle"
  },
  "peerDependencies": {
    "astro": "^5.0.0"
  },
  "devDependencies": {
    "@adamhl8/configs": "^0.16.0",
    "@arethetypeswrong/core": "^0.18.2",
    "@biomejs/biome": "^2.2.4",
    "@types/bun": "^1.2.22",
    "knip": "^5.63.1",
    "markdown-toc": "^1.2.0",
    "publint": "^0.3.13",
    "tsdown": "^0.15.4",
    "typescript": "^5.9.2"
  }
}
