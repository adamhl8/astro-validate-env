{
  "name": "astro-validate-env",
  "version": "0.3.0",
  "type": "module",
  "description": "A environment variable validation integration for Astro",
  "repository": {
    "type": "git",
    "url": "https://github.com/adamhl8/astro-validate-env"
  },
  "homepage": "https://github.com/adamhl8/astro-validate-env",
  "bugs": {
    "url": "https://github.com/adamhl8/astro-validate-env/issues"
  },
  "author": {
    "email": "adamhl@pm.me",
    "name": "Adam Langbert",
    "url": "https://github.com/adamhl8"
  },
  "license": "MIT",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/types/index.d.ts"
    }
  },
  "files": [
    "dist/"
  ],
  "keywords": [
    "astro",
    "astro-integration",
    "astro-component",
    "withastro",
    "utility",
    "environment variables",
    "env"
  ],
  "scripts": {
    "bundle": "rm -rf ./dist && bun lint && tsc -p tsconfig.build.json && tsc-alias",
    "lint": "tsc --noEmit && biome check --write",
    "prepare": "find .githooks -type f -exec ln -srf {} .git/hooks/ \\; || true",
    "prepublishOnly": "bun bundle"
  },
  "peerDependencies": {
    "astro": "^5.0.0"
  },
  "devDependencies": {
    "@adamhl8/configs": "^0.9.0",
    "@biomejs/biome": "^2.0.6",
    "@types/bun": "^1.2.18",
    "tsc-alias": "^1.8.16",
    "typescript": "^5.8.3"
  }
}
